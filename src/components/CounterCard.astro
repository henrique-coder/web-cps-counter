---
interface Props {
  id: string;
  label: string;
  size?: "normal" | "large";
  variant?: "default" | "total" | "left" | "right";
}

const { id, label, size = "normal", variant = "default" } = Astro.props;
---

<div class:list={["counter-card", `size-${size}`, `variant-${variant}`]}>
  <div class="cps-value">
    <span class="number" id={`${id}-cps`}>0.0</span>
    <span class="unit">CPS</span>
  </div>
  <div class="label">{label}</div>
  <div class="max-value">
    <span class="max-label">MAX</span>
    <span class="max-number" id={`${id}-max`}>0.0</span>
  </div>
</div>

<style>
  .counter-card {
    background: var(--bg-secondary);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all var(--transition);
    min-height: 160px;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }

  .counter-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
    opacity: 0.8;
  }

  .counter-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .counter-card:active {
    background: var(--bg-hover);
    transform: translateY(2px) scale(0.98);
  }

  .cps-value {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    position: relative;
    z-index: 1;
  }

  .number {
    font-size: 3.5rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(180deg, #ffffff 0%, #a1a1aa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
  }

  .unit {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    z-index: 1;
  }

  .max-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    background: rgba(0, 0, 0, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.05);
    z-index: 1;
  }

  .max-label {
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--accent-red);
    letter-spacing: 0.1em;
  }

  .max-number {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .size-large .number {
    font-size: 4.5rem;
  }

  .size-large {
    min-height: 180px;
  }

  .variant-total {
    background: linear-gradient(
      145deg,
      rgba(40, 40, 40, 0.8) 0%,
      rgba(20, 20, 20, 0.9) 100%
    );
    border-color: rgba(255, 255, 255, 0.12);
  }

  .variant-total::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 40px rgba(59, 130, 246, 0.05);
    border-radius: inherit;
    pointer-events: none;
  }

  .variant-total .number {
    background: linear-gradient(180deg, #ffffff 0%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .variant-total .max-label {
    color: var(--accent-blue);
  }

  @media (max-width: 600px) {
    .counter-card {
      padding: 1.25rem;
      min-height: 140px;
    }

    .number {
      font-size: 3rem;
    }

    .size-large .number {
      font-size: 3.5rem;
    }

    .size-large {
      min-height: 160px;
    }
  }
</style>
